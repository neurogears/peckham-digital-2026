<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.1"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns:movenet="clr-namespace:Bonsai.TensorFlow.MoveNet;assembly=Bonsai.TensorFlow.MoveNet"
                 xmlns:rx="clr-namespace:Bonsai.Reactive;assembly=Bonsai.Core"
                 xmlns:scr="clr-namespace:Bonsai.Scripting.Expressions;assembly=Bonsai.Scripting.Expressions"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Workflow>
    <Nodes>
      <Expression xsi:type="WorkflowInput">
        <Name>Source1</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="movenet:PredictSinglePoseThunder">
          <movenet:MinimumConfidence>0.2</movenet:MinimumConfidence>
        </Combinator>
      </Expression>
      <Expression xsi:type="GroupWorkflow">
        <Name>Nose</Name>
        <Workflow>
          <Nodes>
            <Expression xsi:type="WorkflowInput">
              <Name>Source1</Name>
            </Expression>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="Name" />
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="movenet:GetBodyPart">
                <movenet:Name>nose</movenet:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="WorkflowOutput" />
          </Nodes>
          <Edges>
            <Edge From="0" To="2" Label="Source1" />
            <Edge From="1" To="2" Label="Source2" />
            <Edge From="2" To="3" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="GroupWorkflow">
        <Name>LeftWrist</Name>
        <Workflow>
          <Nodes>
            <Expression xsi:type="WorkflowInput">
              <Name>Source1</Name>
            </Expression>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="Name" />
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="movenet:GetBodyPart">
                <movenet:Name>left_wrist</movenet:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="WorkflowOutput" />
          </Nodes>
          <Edges>
            <Edge From="0" To="2" Label="Source1" />
            <Edge From="1" To="2" Label="Source2" />
            <Edge From="2" To="3" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="GroupWorkflow">
        <Name>LeftHandHeight</Name>
        <Description>Height of the left wrist as a fraction of the image height: 0 at the bottom of the image, 1 at the top.</Description>
        <Workflow>
          <Nodes>
            <Expression xsi:type="WorkflowInput">
              <Name>Source1</Name>
            </Expression>
            <Expression xsi:type="WorkflowInput">
              <Name>Source2</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Zip" />
            </Expression>
            <Expression xsi:type="scr:ExpressionCondition">
              <scr:Name>NotNaN</scr:Name>
              <scr:Description>Drops frames where the wrist was not detected (position is NaN).</scr:Description>
              <scr:Expression>!Single.IsNaN(Item1.Position.X) &amp;&amp; !Single.IsNaN(Item1.Position.Y)</scr:Expression>
            </Expression>
            <Expression xsi:type="scr:ExpressionTransform">
              <scr:Expression>1.0 - Item1.Position.Y / Item2.Height</scr:Expression>
            </Expression>
            <Expression xsi:type="WorkflowOutput" />
          </Nodes>
          <Edges>
            <Edge From="0" To="2" Label="Source1" />
            <Edge From="1" To="2" Label="Source2" />
            <Edge From="2" To="3" Label="Source1" />
            <Edge From="3" To="4" Label="Source1" />
            <Edge From="4" To="5" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="rx:PublishSubject">
        <Name>LeftHandHeight</Name>
      </Expression>
      <Expression xsi:type="GroupWorkflow">
        <Name>RightWrist</Name>
        <Workflow>
          <Nodes>
            <Expression xsi:type="WorkflowInput">
              <Name>Source1</Name>
            </Expression>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="Name" />
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="movenet:GetBodyPart">
                <movenet:Name>right_wrist</movenet:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="WorkflowOutput" />
          </Nodes>
          <Edges>
            <Edge From="0" To="2" Label="Source1" />
            <Edge From="1" To="2" Label="Source2" />
            <Edge From="2" To="3" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="GroupWorkflow">
        <Name>RightHandHeight</Name>
        <Description>Height of the right wrist as a fraction of the image height: 0 at the bottom of the image, 1 at the top.</Description>
        <Workflow>
          <Nodes>
            <Expression xsi:type="WorkflowInput">
              <Name>Source1</Name>
            </Expression>
            <Expression xsi:type="WorkflowInput">
              <Name>Source2</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Zip" />
            </Expression>
            <Expression xsi:type="scr:ExpressionCondition">
              <scr:Name>NotNaN</scr:Name>
              <scr:Description>Drops frames where the wrist was not detected (position is NaN).</scr:Description>
              <scr:Expression>!Single.IsNaN(Item1.Position.X) &amp;&amp; !Single.IsNaN(Item1.Position.Y)</scr:Expression>
            </Expression>
            <Expression xsi:type="scr:ExpressionTransform">
              <scr:Expression>1.0 - Item1.Position.Y / Item2.Height</scr:Expression>
            </Expression>
            <Expression xsi:type="WorkflowOutput" />
          </Nodes>
          <Edges>
            <Edge From="0" To="2" Label="Source1" />
            <Edge From="1" To="2" Label="Source2" />
            <Edge From="2" To="3" Label="Source1" />
            <Edge From="3" To="4" Label="Source1" />
            <Edge From="4" To="5" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="rx:PublishSubject">
        <Name>RightHandHeight</Name>
      </Expression>
      <Expression xsi:type="GroupWorkflow">
        <Name>LeftEye</Name>
        <Workflow>
          <Nodes>
            <Expression xsi:type="WorkflowInput">
              <Name>Source1</Name>
            </Expression>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="Name" />
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="movenet:GetBodyPart">
                <movenet:Name>left_eye</movenet:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="WorkflowOutput" />
          </Nodes>
          <Edges>
            <Edge From="0" To="2" Label="Source1" />
            <Edge From="1" To="2" Label="Source2" />
            <Edge From="2" To="3" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="GroupWorkflow">
        <Name>RightEye</Name>
        <Workflow>
          <Nodes>
            <Expression xsi:type="WorkflowInput">
              <Name>Source1</Name>
            </Expression>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="Name" />
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="movenet:GetBodyPart">
                <movenet:Name>right_eye</movenet:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="WorkflowOutput" />
          </Nodes>
          <Edges>
            <Edge From="0" To="2" Label="Source1" />
            <Edge From="1" To="2" Label="Source2" />
            <Edge From="2" To="3" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="GroupWorkflow">
        <Name>HeadAngle</Name>
        <Description>Tilt of the line from the right eye to the left eye relative to the image horizontal, in degrees. 0 is level, positive when the left eye is higher.</Description>
        <Workflow>
          <Nodes>
            <Expression xsi:type="WorkflowInput">
              <Name>Source1</Name>
            </Expression>
            <Expression xsi:type="WorkflowInput">
              <Name>Source2</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Zip" />
            </Expression>
            <Expression xsi:type="scr:ExpressionCondition">
              <scr:Name>NotNaN</scr:Name>
              <scr:Description>Drops frames where either eye was not detected (position is NaN).</scr:Description>
              <scr:Expression>!Single.IsNaN(Item1.Position.X) &amp;&amp; !Single.IsNaN(Item1.Position.Y) &amp;&amp; !Single.IsNaN(Item2.Position.X) &amp;&amp; !Single.IsNaN(Item2.Position.Y)</scr:Expression>
            </Expression>
            <Expression xsi:type="scr:ExpressionTransform">
              <scr:Expression>Math.Atan2(Item2.Position.Y - Item1.Position.Y, Item1.Position.X - Item2.Position.X) * 180 / Math.PI</scr:Expression>
            </Expression>
            <Expression xsi:type="WorkflowOutput" />
          </Nodes>
          <Edges>
            <Edge From="0" To="2" Label="Source1" />
            <Edge From="1" To="2" Label="Source2" />
            <Edge From="2" To="3" Label="Source1" />
            <Edge From="3" To="4" Label="Source1" />
            <Edge From="4" To="5" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="rx:PublishSubject">
        <Name>HeadAngle</Name>
      </Expression>
      <Expression xsi:type="GroupWorkflow">
        <Name>LeftShoulder</Name>
        <Workflow>
          <Nodes>
            <Expression xsi:type="WorkflowInput">
              <Name>Source1</Name>
            </Expression>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="Name" />
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="movenet:GetBodyPart">
                <movenet:Name>left_shoulder</movenet:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="WorkflowOutput" />
          </Nodes>
          <Edges>
            <Edge From="0" To="2" Label="Source1" />
            <Edge From="1" To="2" Label="Source2" />
            <Edge From="2" To="3" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="GroupWorkflow">
        <Name>LeftElbow</Name>
        <Workflow>
          <Nodes>
            <Expression xsi:type="WorkflowInput">
              <Name>Source1</Name>
            </Expression>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="Name" />
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="movenet:GetBodyPart">
                <movenet:Name>left_elbow</movenet:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="WorkflowOutput" />
          </Nodes>
          <Edges>
            <Edge From="0" To="2" Label="Source1" />
            <Edge From="1" To="2" Label="Source2" />
            <Edge From="2" To="3" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="GroupWorkflow">
        <Name>LeftUpperArmAngle</Name>
        <Description>Angle of the left shoulder-to-elbow line relative to the image horizontal, in degrees. 0 is arm straight out to the side, +90 straight up, -90 straight down.</Description>
        <Workflow>
          <Nodes>
            <Expression xsi:type="WorkflowInput">
              <Name>Source1</Name>
            </Expression>
            <Expression xsi:type="WorkflowInput">
              <Name>Source2</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Zip" />
            </Expression>
            <Expression xsi:type="scr:ExpressionCondition">
              <scr:Name>NotNaN</scr:Name>
              <scr:Description>Drops frames where the shoulder or elbow was not detected (position is NaN).</scr:Description>
              <scr:Expression>!Single.IsNaN(Item1.Position.X) &amp;&amp; !Single.IsNaN(Item1.Position.Y) &amp;&amp; !Single.IsNaN(Item2.Position.X) &amp;&amp; !Single.IsNaN(Item2.Position.Y)</scr:Expression>
            </Expression>
            <Expression xsi:type="scr:ExpressionTransform">
              <scr:Expression>Math.Atan2(Item1.Position.Y - Item2.Position.Y, Item2.Position.X - Item1.Position.X) * 180 / Math.PI</scr:Expression>
            </Expression>
            <Expression xsi:type="WorkflowOutput" />
          </Nodes>
          <Edges>
            <Edge From="0" To="2" Label="Source1" />
            <Edge From="1" To="2" Label="Source2" />
            <Edge From="2" To="3" Label="Source1" />
            <Edge From="3" To="4" Label="Source1" />
            <Edge From="4" To="5" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="rx:PublishSubject">
        <Name>LeftUpperArmAngle</Name>
      </Expression>
      <Expression xsi:type="GroupWorkflow">
        <Name>RightShoulder</Name>
        <Workflow>
          <Nodes>
            <Expression xsi:type="WorkflowInput">
              <Name>Source1</Name>
            </Expression>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="Name" />
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="movenet:GetBodyPart">
                <movenet:Name>right_shoulder</movenet:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="WorkflowOutput" />
          </Nodes>
          <Edges>
            <Edge From="0" To="2" Label="Source1" />
            <Edge From="1" To="2" Label="Source2" />
            <Edge From="2" To="3" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="GroupWorkflow">
        <Name>RightElbow</Name>
        <Workflow>
          <Nodes>
            <Expression xsi:type="WorkflowInput">
              <Name>Source1</Name>
            </Expression>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="Name" />
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="movenet:GetBodyPart">
                <movenet:Name>right_elbow</movenet:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="WorkflowOutput" />
          </Nodes>
          <Edges>
            <Edge From="0" To="2" Label="Source1" />
            <Edge From="1" To="2" Label="Source2" />
            <Edge From="2" To="3" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="GroupWorkflow">
        <Name>RightUpperArmAngle</Name>
        <Description>Angle of the right shoulder-to-elbow line relative to the image horizontal, in degrees. Mirrored to match the left arm: 0 is arm straight out to the side, +90 straight up, -90 straight down.</Description>
        <Workflow>
          <Nodes>
            <Expression xsi:type="WorkflowInput">
              <Name>Source1</Name>
            </Expression>
            <Expression xsi:type="WorkflowInput">
              <Name>Source2</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Zip" />
            </Expression>
            <Expression xsi:type="scr:ExpressionCondition">
              <scr:Name>NotNaN</scr:Name>
              <scr:Description>Drops frames where the shoulder or elbow was not detected (position is NaN).</scr:Description>
              <scr:Expression>!Single.IsNaN(Item1.Position.X) &amp;&amp; !Single.IsNaN(Item1.Position.Y) &amp;&amp; !Single.IsNaN(Item2.Position.X) &amp;&amp; !Single.IsNaN(Item2.Position.Y)</scr:Expression>
            </Expression>
            <Expression xsi:type="scr:ExpressionTransform">
              <scr:Expression>Math.Atan2(Item1.Position.Y - Item2.Position.Y, Item1.Position.X - Item2.Position.X) * 180 / Math.PI</scr:Expression>
            </Expression>
            <Expression xsi:type="WorkflowOutput" />
          </Nodes>
          <Edges>
            <Edge From="0" To="2" Label="Source1" />
            <Edge From="1" To="2" Label="Source2" />
            <Edge From="2" To="3" Label="Source1" />
            <Edge From="3" To="4" Label="Source1" />
            <Edge From="4" To="5" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="rx:PublishSubject">
        <Name>RightUpperArmAngle</Name>
      </Expression>
      <Expression xsi:type="GroupWorkflow">
        <Name>LeftLowerArmAngle</Name>
        <Description>Angle of the left elbow-to-wrist line relative to the shoulder-to-elbow line, in degrees. 0 is a straight arm, positive when the forearm bends upward from the upper arm, negative when it bends downward.</Description>
        <Workflow>
          <Nodes>
            <Expression xsi:type="WorkflowInput">
              <Name>Source1</Name>
            </Expression>
            <Expression xsi:type="WorkflowInput">
              <Name>Source2</Name>
            </Expression>
            <Expression xsi:type="WorkflowInput">
              <Name>Source3</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Zip" />
            </Expression>
            <Expression xsi:type="scr:ExpressionCondition">
              <scr:Name>NotNaN</scr:Name>
              <scr:Description>Drops frames where the shoulder, elbow or wrist was not detected (position is NaN).</scr:Description>
              <scr:Expression>!Single.IsNaN(Item1.Position.X) &amp;&amp; !Single.IsNaN(Item1.Position.Y) &amp;&amp; !Single.IsNaN(Item2.Position.X) &amp;&amp; !Single.IsNaN(Item2.Position.Y) &amp;&amp; !Single.IsNaN(Item3.Position.X) &amp;&amp; !Single.IsNaN(Item3.Position.Y)</scr:Expression>
            </Expression>
            <Expression xsi:type="scr:ExpressionTransform">
              <scr:Description>Signed angle between upper arm (shoulder to elbow) and forearm (elbow to wrist), from their cross and dot products with the image y axis flipped so up is positive.</scr:Description>
              <scr:Expression>Math.Atan2((Item2.Position.X - Item1.Position.X) * (Item2.Position.Y - Item3.Position.Y) - (Item1.Position.Y - Item2.Position.Y) * (Item3.Position.X - Item2.Position.X), (Item2.Position.X - Item1.Position.X) * (Item3.Position.X - Item2.Position.X) + (Item1.Position.Y - Item2.Position.Y) * (Item2.Position.Y - Item3.Position.Y)) * 180 / Math.PI</scr:Expression>
            </Expression>
            <Expression xsi:type="WorkflowOutput" />
          </Nodes>
          <Edges>
            <Edge From="0" To="3" Label="Source1" />
            <Edge From="1" To="3" Label="Source2" />
            <Edge From="2" To="3" Label="Source3" />
            <Edge From="3" To="4" Label="Source1" />
            <Edge From="4" To="5" Label="Source1" />
            <Edge From="5" To="6" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="rx:PublishSubject">
        <Name>LeftLowerArmAngle</Name>
      </Expression>
      <Expression xsi:type="GroupWorkflow">
        <Name>RightLowerArmAngle</Name>
        <Description>Angle of the right elbow-to-wrist line relative to the shoulder-to-elbow line, in degrees. Mirrored to match the left arm: 0 is a straight arm, positive when the forearm bends upward from the upper arm, negative when it bends downward.</Description>
        <Workflow>
          <Nodes>
            <Expression xsi:type="WorkflowInput">
              <Name>Source1</Name>
            </Expression>
            <Expression xsi:type="WorkflowInput">
              <Name>Source2</Name>
            </Expression>
            <Expression xsi:type="WorkflowInput">
              <Name>Source3</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Zip" />
            </Expression>
            <Expression xsi:type="scr:ExpressionCondition">
              <scr:Name>NotNaN</scr:Name>
              <scr:Description>Drops frames where the shoulder, elbow or wrist was not detected (position is NaN).</scr:Description>
              <scr:Expression>!Single.IsNaN(Item1.Position.X) &amp;&amp; !Single.IsNaN(Item1.Position.Y) &amp;&amp; !Single.IsNaN(Item2.Position.X) &amp;&amp; !Single.IsNaN(Item2.Position.Y) &amp;&amp; !Single.IsNaN(Item3.Position.X) &amp;&amp; !Single.IsNaN(Item3.Position.Y)</scr:Expression>
            </Expression>
            <Expression xsi:type="scr:ExpressionTransform">
              <scr:Description>Same as the left arm but with x mirrored, so the sign of the bend means the same thing on both sides.</scr:Description>
              <scr:Expression>Math.Atan2((Item1.Position.X - Item2.Position.X) * (Item2.Position.Y - Item3.Position.Y) - (Item1.Position.Y - Item2.Position.Y) * (Item2.Position.X - Item3.Position.X), (Item2.Position.X - Item1.Position.X) * (Item3.Position.X - Item2.Position.X) + (Item1.Position.Y - Item2.Position.Y) * (Item2.Position.Y - Item3.Position.Y)) * 180 / Math.PI</scr:Expression>
            </Expression>
            <Expression xsi:type="WorkflowOutput" />
          </Nodes>
          <Edges>
            <Edge From="0" To="3" Label="Source1" />
            <Edge From="1" To="3" Label="Source2" />
            <Edge From="2" To="3" Label="Source3" />
            <Edge From="3" To="4" Label="Source1" />
            <Edge From="4" To="5" Label="Source1" />
            <Edge From="5" To="6" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="rx:PublishSubject">
        <Name>RightLowerArmAngle</Name>
      </Expression>
    </Nodes>
    <Edges>
      <Edge From="0" To="1" Label="Source1" />
      <Edge From="0" To="4" Label="Source2" />
      <Edge From="0" To="7" Label="Source2" />
      <Edge From="1" To="2" Label="Source1" />
      <Edge From="1" To="3" Label="Source1" />
      <Edge From="1" To="6" Label="Source1" />
      <Edge From="1" To="9" Label="Source1" />
      <Edge From="1" To="10" Label="Source1" />
      <Edge From="1" To="13" Label="Source1" />
      <Edge From="1" To="14" Label="Source1" />
      <Edge From="1" To="17" Label="Source1" />
      <Edge From="1" To="18" Label="Source1" />
      <Edge From="3" To="4" Label="Source1" />
      <Edge From="3" To="21" Label="Source3" />
      <Edge From="4" To="5" Label="Source1" />
      <Edge From="6" To="7" Label="Source1" />
      <Edge From="6" To="23" Label="Source3" />
      <Edge From="7" To="8" Label="Source1" />
      <Edge From="9" To="11" Label="Source1" />
      <Edge From="10" To="11" Label="Source2" />
      <Edge From="11" To="12" Label="Source1" />
      <Edge From="13" To="15" Label="Source1" />
      <Edge From="13" To="21" Label="Source1" />
      <Edge From="14" To="15" Label="Source2" />
      <Edge From="14" To="21" Label="Source2" />
      <Edge From="15" To="16" Label="Source1" />
      <Edge From="17" To="19" Label="Source1" />
      <Edge From="17" To="23" Label="Source1" />
      <Edge From="18" To="19" Label="Source2" />
      <Edge From="18" To="23" Label="Source2" />
      <Edge From="19" To="20" Label="Source1" />
      <Edge From="21" To="22" Label="Source1" />
      <Edge From="23" To="24" Label="Source1" />
    </Edges>
  </Workflow>
</WorkflowBuilder>