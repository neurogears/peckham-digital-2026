                  <drw:Val1>140</drw:Val1>
                  <drw:Val2>255</drw:Val2>
                  <drw:Val3>0</drw:Val3>
                </drw:Color>
                <drw:Thickness>14</drw:Thickness>
                <drw:LineType>AntiAliased</drw:LineType>
                <drw:Shift>0</drw:Shift>
