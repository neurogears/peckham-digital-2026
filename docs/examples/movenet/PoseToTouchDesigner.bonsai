            <Edge From="12" To="13" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="GroupWorkflow">
        <Name>Trunk</Name>
        <Description>Shoulders and hips as a loop, then nose to both shoulders. No dots: the limbs already drew them.</Description>
        <Workflow>
          <Nodes>
            <Expression xsi:type="WorkflowInput">
              <Name>Source1</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>Pose</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="movenet:GetBodyPart">
                <movenet:Name>left_shoulder</movenet:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="movenet:GetBodyPart">
                <movenet:Name>right_shoulder</movenet:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="movenet:GetBodyPart">
                <movenet:Name>right_hip</movenet:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="movenet:GetBodyPart">
                <movenet:Name>left_hip</movenet:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="movenet:GetBodyPart">
                <movenet:Name>nose</movenet:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>Gap</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Zip" />
            </Expression>
            <Expression xsi:type="scr:ExpressionTransform">
              <scr:Name>Lines</scr:Name>
              <scr:Expression>new[] { Item4.Position, Item1.Position, Item2.Position, Item3.Position, Item4.Position, Item6, Item1.Position, Item5.Position, Item2.Position }</scr:Expression>
            </Expression>
            <Expression xsi:type="PropertyMapping">
              <PropertyMappings>
                <Property Name="Points" />
              </PropertyMappings>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="drw:Path">
                <drw:Color>
                  <drw:Val0>0</drw:Val0>
                  <drw:Val1>255</drw:Val1>
                  <drw:Val2>255</drw:Val2>
                  <drw:Val3>0</drw:Val3>
                </drw:Color>
                <drw:Thickness>3</drw:Thickness>
                <drw:LineType>AntiAliased</drw:LineType>
                <drw:Shift>0</drw:Shift>
              </Combinator>
            </Expression>
            <Expression xsi:type="WorkflowOutput" />
          </Nodes>
          <Edges>
            <Edge From="0" To="11" Label="Source1" />
            <Edge From="1" To="2" Label="Source1" />
            <Edge From="1" To="3" Label="Source1" />
            <Edge From="1" To="4" Label="Source1" />
            <Edge From="1" To="5" Label="Source1" />
            <Edge From="1" To="6" Label="Source1" />
            <Edge From="2" To="8" Label="Source1" />
            <Edge From="3" To="8" Label="Source2" />
            <Edge From="4" To="8" Label="Source3" />
            <Edge From="5" To="8" Label="Source4" />
            <Edge From="6" To="8" Label="Source5" />
            <Edge From="7" To="8" Label="Source6" />
            <Edge From="8" To="9" Label="Source1" />
            <Edge From="9" To="10" Label="Source1" />
            <Edge From="10" To="11" Label="Source2" />
            <Edge From="11" To="12" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="drw:DrawCanvas" />
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>Pose</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="movenet:GetBodyPart">
          <movenet:Name>nose</movenet:Name>
        </Combinator>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>Position</Selector>
      </Expression>
      <Expression xsi:type="scr:ExpressionTransform">
        <scr:Name>NaN point</scr:Name>
        <scr:Description>A point that is not a point. Path breaks the line wherever it meets one, so this is the gap between dots.</scr:Description>
        <scr:Expression>new Point2f(Single.NaN, Single.NaN)</scr:Expression>
      </Expression>
      <Expression xsi:type="rx:PublishSubject">
        <Name>Gap</Name>
      </Expression>
      <Expression xsi:type="GroupWorkflow">
        <Name>TouchDesigner</Name>
        <Description>Five body measurements, each squeezed to 0 to 1 and sent to one knob of the Ember Pulse patch on UDP port 8000.</Description>
        <Workflow>
          <Nodes>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="osc:CreateUdpClient">
                <osc:Name>Out</osc:Name>
                <osc:Port>0</osc:Port>
                <osc:RemoteHostName>127.0.0.1</osc:RemoteHostName>
                <osc:RemotePort>8000</osc:RemotePort>
              </Combinator>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>Pose</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="movenet:GetBodyPart">
                <movenet:Name>nose</movenet:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>Position.X</Selector>
            </Expression>
            <Expression xsi:type="scr:ExpressionCondition">
              <scr:Expression>!Single.IsNaN(it)</scr:Expression>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="dsp:Rescale">
                <dsp:Min>0</dsp:Min>
                <dsp:Max>640</dsp:Max>
                <dsp:RangeMin>0</dsp:RangeMin>
                <dsp:RangeMax>1</dsp:RangeMax>
                <dsp:RescaleType>Clamp</dsp:RescaleType>
              </Combinator>
            </Expression>
            <Expression xsi:type="scr:ExpressionTransform">
              <scr:Expression>Convert.ToSingle(it)</scr:Expression>
            </Expression>
            <Expression xsi:type="osc:SendMessage">
              <osc:Connection>Out</osc:Connection>
              <osc:Address>/spin</osc:Address>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="movenet:GetBodyPart">
                <movenet:Name>left_wrist</movenet:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="movenet:GetBodyPart">
                <movenet:Name>right_wrist</movenet:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="movenet:GetBodyPart">
                <movenet:Name>left_shoulder</movenet:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="movenet:GetBodyPart">
                <movenet:Name>right_shoulder</movenet:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Zip" />
            </Expression>
            <Expression xsi:type="scr:ExpressionTransform">
              <scr:Name>Higher wrist</scr:Name>
              <scr:Description>Pixel row of whichever wrist is higher. Rows count down from the top, so the smaller number is the higher hand.</scr:Description>
              <scr:Expression>Math.Min(Item1.Position.Y, Item2.Position.Y)</scr:Expression>
            </Expression>
            <Expression xsi:type="scr:ExpressionCondition">
              <scr:Expression>!Double.IsNaN(it)</scr:Expression>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="dsp:Rescale">
                <dsp:Min>0</dsp:Min>
                <dsp:Max>480</dsp:Max>
                <dsp:RangeMin>1</dsp:RangeMin>
                <dsp:RangeMax>0</dsp:RangeMax>
                <dsp:RescaleType>Clamp</dsp:RescaleType>
              </Combinator>
            </Expression>
            <Expression xsi:type="scr:ExpressionTransform">
              <scr:Expression>Convert.ToSingle(it)</scr:Expression>
            </Expression>
            <Expression xsi:type="osc:SendMessage">
              <osc:Connection>Out</osc:Connection>
              <osc:Address>/pulse</osc:Address>
            </Expression>
            <Expression xsi:type="scr:ExpressionTransform">
              <scr:Name>Lower wrist</scr:Name>
              <scr:Description>Pixel row of whichever wrist is lower.</scr:Description>
              <scr:Expression>Math.Max(Item1.Position.Y, Item2.Position.Y)</scr:Expression>
            </Expression>
            <Expression xsi:type="scr:ExpressionCondition">
              <scr:Expression>!Double.IsNaN(it)</scr:Expression>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="dsp:Rescale">
                <dsp:Min>0</dsp:Min>
                <dsp:Max>480</dsp:Max>
                <dsp:RangeMin>1</dsp:RangeMin>
                <dsp:RangeMax>0</dsp:RangeMax>
                <dsp:RescaleType>Clamp</dsp:RescaleType>
              </Combinator>
            </Expression>
            <Expression xsi:type="scr:ExpressionTransform">
              <scr:Expression>Convert.ToSingle(it)</scr:Expression>
            </Expression>
            <Expression xsi:type="osc:SendMessage">
              <osc:Connection>Out</osc:Connection>
              <osc:Address>/trail</osc:Address>
            </Expression>
            <Expression xsi:type="scr:ExpressionTransform">
              <scr:Name>Wrist spread</scr:Name>
              <scr:Description>Distance between the wrists divided by the distance between the shoulders, so the number is about your body, not about how close you stand to the camera.</scr:Description>
              <scr:Expression>Math.Sqrt(Math.Pow(Item1.Position.X - Item2.Position.X, 2) + Math.Pow(Item1.Position.Y - Item2.Position.Y, 2)) / Math.Sqrt(Math.Pow(Item3.Position.X - Item4.Position.X, 2) + Math.Pow(Item3.Position.Y - Item4.Position.Y, 2))</scr:Expression>
            </Expression>
            <Expression xsi:type="scr:ExpressionCondition">
              <scr:Expression>!Double.IsNaN(it)</scr:Expression>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="dsp:Rescale">
                <dsp:Min>1</dsp:Min>
                <dsp:Max>4</dsp:Max>
                <dsp:RangeMin>0</dsp:RangeMin>
                <dsp:RangeMax>1</dsp:RangeMax>
                <dsp:RescaleType>Clamp</dsp:RescaleType>
              </Combinator>
            </Expression>
            <Expression xsi:type="scr:ExpressionTransform">
              <scr:Expression>Convert.ToSingle(it)</scr:Expression>
            </Expression>
            <Expression xsi:type="osc:SendMessage">
              <osc:Connection>Out</osc:Connection>
              <osc:Address>/hue</osc:Address>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="movenet:GetBodyPart">
                <movenet:Name>left_ankle</movenet:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="movenet:GetBodyPart">
                <movenet:Name>right_ankle</movenet:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Zip" />
            </Expression>
            <Expression xsi:type="scr:ExpressionTransform">
              <scr:Name>Feet spread</scr:Name>
              <scr:Description>Distance between the ankles divided by the distance between the shoulders.</scr:Description>
              <scr:Expression>Math.Sqrt(Math.Pow(Item1.Position.X - Item2.Position.X, 2) + Math.Pow(Item1.Position.Y - Item2.Position.Y, 2)) / Math.Sqrt(Math.Pow(Item3.Position.X - Item4.Position.X, 2) + Math.Pow(Item3.Position.Y - Item4.Position.Y, 2))</scr:Expression>
            </Expression>
            <Expression xsi:type="scr:ExpressionCondition">
              <scr:Expression>!Double.IsNaN(it)</scr:Expression>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="dsp:Rescale">
                <dsp:Min>1</dsp:Min>
                <dsp:Max>2.5</dsp:Max>
                <dsp:RangeMin>0</dsp:RangeMin>
                <dsp:RangeMax>1</dsp:RangeMax>
                <dsp:RescaleType>Clamp</dsp:RescaleType>
              </Combinator>
            </Expression>
            <Expression xsi:type="scr:ExpressionTransform">
              <scr:Expression>Convert.ToSingle(it)</scr:Expression>
            </Expression>
            <Expression xsi:type="osc:SendMessage">
              <osc:Connection>Out</osc:Connection>
              <osc:Address>/zoom</osc:Address>
            </Expression>
          </Nodes>
          <Edges>
            <Edge From="1" To="2" Label="Source1" />
            <Edge From="1" To="8" Label="Source1" />
            <Edge From="1" To="9" Label="Source1" />
            <Edge From="1" To="10" Label="Source1" />
            <Edge From="1" To="11" Label="Source1" />
            <Edge From="1" To="28" Label="Source1" />
            <Edge From="1" To="29" Label="Source1" />
            <Edge From="2" To="3" Label="Source1" />
            <Edge From="3" To="4" Label="Source1" />
            <Edge From="4" To="5" Label="Source1" />
            <Edge From="5" To="6" Label="Source1" />
            <Edge From="6" To="7" Label="Source1" />
            <Edge From="8" To="12" Label="Source1" />
            <Edge From="9" To="12" Label="Source2" />
            <Edge From="10" To="12" Label="Source3" />
            <Edge From="10" To="30" Label="Source3" />
            <Edge From="11" To="12" Label="Source4" />
            <Edge From="11" To="30" Label="Source4" />
            <Edge From="12" To="13" Label="Source1" />
            <Edge From="12" To="18" Label="Source1" />
            <Edge From="12" To="23" Label="Source1" />
            <Edge From="13" To="14" Label="Source1" />
            <Edge From="14" To="15" Label="Source1" />
            <Edge From="15" To="16" Label="Source1" />
            <Edge From="16" To="17" Label="Source1" />
            <Edge From="18" To="19" Label="Source1" />
            <Edge From="19" To="20" Label="Source1" />
            <Edge From="20" To="21" Label="Source1" />
            <Edge From="21" To="22" Label="Source1" />
            <Edge From="23" To="24" Label="Source1" />
            <Edge From="24" To="25" Label="Source1" />
            <Edge From="25" To="26" Label="Source1" />
            <Edge From="26" To="27" Label="Source1" />
            <Edge From="28" To="30" Label="Source1" />
            <Edge From="29" To="30" Label="Source2" />
            <Edge From="30" To="31" Label="Source1" />
            <Edge From="31" To="32" Label="Source1" />
            <Edge From="32" To="33" Label="Source1" />
            <Edge From="33" To="34" Label="Source1" />
            <Edge From="34" To="35" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
    </Nodes>
    <Edges>
      <Edge From="0" To="1" Label="Source1" />
      <Edge From="1" To="2" Label="Source1" />
      <Edge From="2" To="3" Label="Source1" />
      <Edge From="4" To="5" Label="Source1" />
      <Edge From="5" To="6" Label="Source1" />
      <Edge From="6" To="7" Label="Source1" />
      <Edge From="7" To="11" Label="Source1" />
      <Edge From="8" To="9" Label="Source1" />
      <Edge From="9" To="10" Label="Source1" />
      <Edge From="10" To="11" Label="Source2" />
      <Edge From="11" To="12" Label="Source1" />
      <Edge From="12" To="13" Label="Source1" />
      <Edge From="13" To="14" Label="Source1" />
      <Edge From="14" To="15" Label="Source1" />
      <Edge From="15" To="16" Label="Source1" />
      <Edge From="16" To="17" Label="Source1" />
      <Edge From="17" To="18" Label="Source1" />
      <Edge From="19" To="20" Label="Source1" />
      <Edge From="20" To="21" Label="Source1" />
      <Edge From="21" To="22" Label="Source1" />
      <Edge From="22" To="23" Label="Source1" />
    </Edges>
  </Workflow>
</WorkflowBuilder>