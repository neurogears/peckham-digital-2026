<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.1"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns:cv="clr-namespace:Bonsai.Vision;assembly=Bonsai.Vision"
                 xmlns:draw="clr-namespace:Bonsai.Vision.Drawing;assembly=Bonsai.Vision"
                 xmlns:movenet="clr-namespace:Bonsai.TensorFlow.MoveNet;assembly=Bonsai.TensorFlow.MoveNet"
                 xmlns:rx="clr-namespace:Bonsai.Reactive;assembly=Bonsai.Core"
                 xmlns:scr="clr-namespace:Bonsai.Scripting.Expressions;assembly=Bonsai.Scripting.Expressions"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Workflow>
    <Nodes>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="cv:CameraCapture">
          <cv:Index>0</cv:Index>
          <cv:CaptureProperties />
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="cv:Flip">
          <cv:Mode>Horizontal</cv:Mode>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="movenet:PredictSinglePoseThunder">
          <movenet:MinimumConfidence>0.3</movenet:MinimumConfidence>
        </Combinator>
      </Expression>
      <Expression xsi:type="rx:PublishSubject">
        <Name>Pose</Name>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>Image</Selector>
      </Expression>
      <Expression xsi:type="PropertyMapping">
        <PropertyMappings>
          <Property Name="Size" Selector="Size" />
        </PropertyMappings>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="draw:CreateCanvas">
          <draw:Size>
            <draw:Width>640</draw:Width>
            <draw:Height>480</draw:Height>
          </draw:Size>
          <draw:Depth>U8</draw:Depth>
          <draw:Channels>3</draw:Channels>
          <draw:Color>
            <draw:Val0>0</draw:Val0>
            <draw:Val1>0</draw:Val1>
            <draw:Val2>0</draw:Val2>
            <draw:Val3>0</draw:Val3>
          </draw:Color>
        </Combinator>
      </Expression>
      <Expression xsi:type="PropertyMapping">
        <PropertyMappings>
          <Property Name="Image" />
        </PropertyMappings>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="draw:AddImage">
          <draw:Destination>
            <draw:X>0</draw:X>
            <draw:Y>0</draw:Y>
            <draw:Width>0</draw:Width>
            <draw:Height>0</draw:Height>
          </draw:Destination>
          <draw:Interpolation>Linear</draw:Interpolation>
        </Combinator>
      </Expression>
      <Expression xsi:type="GroupWorkflow">
        <Name>Face</Name>
        <Description>Ear, eye, nose, eye, ear: one path through the five face points, and a dot on each.</Description>
        <Workflow>
          <Nodes>
            <Expression xsi:type="WorkflowInput">
              <Name>Source1</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>Pose</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="movenet:GetBodyPart">
                <movenet:Name>left_ear</movenet:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="movenet:GetBodyPart">
                <movenet:Name>left_eye</movenet:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="movenet:GetBodyPart">
                <movenet:Name>nose</movenet:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="movenet:GetBodyPart">
                <movenet:Name>right_eye</movenet:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="movenet:GetBodyPart">
                <movenet:Name>right_ear</movenet:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>Gap</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Zip" />
            </Expression>
            <Expression xsi:type="scr:ExpressionTransform">
              <scr:Name>Lines</scr:Name>
              <scr:Expression>new[] { Item1.Position, Item2.Position, Item3.Position, Item4.Position, Item5.Position }</scr:Expression>
            </Expression>
            <Expression xsi:type="PropertyMapping">
              <PropertyMappings>
                <Property Name="Points" />
              </PropertyMappings>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="draw:Path">
                <draw:Color>
                  <draw:Val0>0</draw:Val0>
                  <draw:Val1>255</draw:Val1>
                  <draw:Val2>255</draw:Val2>
                  <draw:Val3>0</draw:Val3>
                </draw:Color>
                <draw:Thickness>3</draw:Thickness>
                <draw:LineType>AntiAliased</draw:LineType>
                <draw:Shift>0</draw:Shift>
              </Combinator>
            </Expression>
            <Expression xsi:type="scr:ExpressionTransform">
              <scr:Name>Dots</scr:Name>
              <scr:Expression>new[] { Item1.Position, Item1.Position, Item6, Item2.Position, Item2.Position, Item6, Item3.Position, Item3.Position, Item6, Item4.Position, Item4.Position, Item6, Item5.Position, Item5.Position }</scr:Expression>
            </Expression>
            <Expression xsi:type="PropertyMapping">
              <PropertyMappings>
                <Property Name="Points" />
              </PropertyMappings>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="draw:Path">
                <draw:Color>
                  <draw:Val0>0</draw:Val0>
                  <draw:Val1>255</draw:Val1>
                  <draw:Val2>255</draw:Val2>
                  <draw:Val3>0</draw:Val3>
                </draw:Color>
                <draw:Thickness>14</draw:Thickness>
                <draw:LineType>AntiAliased</draw:LineType>
                <draw:Shift>0</draw:Shift>
              </Combinator>
            </Expression>
            <Expression xsi:type="WorkflowOutput" />
          </Nodes>
          <Edges>
            <Edge From="0" To="11" Label="Source1" />
            <Edge From="1" To="2" Label="Source1" />
            <Edge From="1" To="3" Label="Source1" />
            <Edge From="1" To="4" Label="Source1" />
            <Edge From="1" To="5" Label="Source1" />
            <Edge From="1" To="6" Label="Source1" />
            <Edge From="2" To="8" Label="Source1" />
            <Edge From="3" To="8" Label="Source2" />
            <Edge From="4" To="8" Label="Source3" />
            <Edge From="5" To="8" Label="Source4" />
            <Edge From="6" To="8" Label="Source5" />
            <Edge From="7" To="8" Label="Source6" />
            <Edge From="8" To="9" Label="Source1" />
            <Edge From="9" To="10" Label="Source1" />
            <Edge From="10" To="11" Label="Source2" />
            <Edge From="11" To="14" Label="Source1" />
            <Edge From="8" To="12" Label="Source1" />
            <Edge From="12" To="13" Label="Source1" />
            <Edge From="13" To="14" Label="Source2" />
            <Edge From="14" To="15" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="GroupWorkflow">
        <Name>LeftArm</Name>
        <Description>Wrist, elbow, shoulder.</Description>
        <Workflow>
          <Nodes>
            <Expression xsi:type="WorkflowInput">
              <Name>Source1</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>Pose</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="movenet:GetBodyPart">
                <movenet:Name>left_wrist</movenet:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="movenet:GetBodyPart">
                <movenet:Name>left_elbow</movenet:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="movenet:GetBodyPart">
                <movenet:Name>left_shoulder</movenet:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>Gap</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Zip" />
            </Expression>
            <Expression xsi:type="scr:ExpressionTransform">
              <scr:Name>Lines</scr:Name>
              <scr:Expression>new[] { Item1.Position, Item2.Position, Item3.Position }</scr:Expression>
            </Expression>
            <Expression xsi:type="PropertyMapping">
              <PropertyMappings>
                <Property Name="Points" />
              </PropertyMappings>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="draw:Path">
                <draw:Color>
                  <draw:Val0>0</draw:Val0>
                  <draw:Val1>140</draw:Val1>
                  <draw:Val2>255</draw:Val2>
                  <draw:Val3>0</draw:Val3>
                </draw:Color>
                <draw:Thickness>3</draw:Thickness>
                <draw:LineType>AntiAliased</draw:LineType>
                <draw:Shift>0</draw:Shift>
              </Combinator>
            </Expression>
            <Expression xsi:type="scr:ExpressionTransform">
              <scr:Name>Dots</scr:Name>
              <scr:Expression>new[] { Item1.Position, Item1.Position, Item4, Item2.Position, Item2.Position, Item4, Item3.Position, Item3.Position }</scr:Expression>
            </Expression>
            <Expression xsi:type="PropertyMapping">
              <PropertyMappings>
                <Property Name="Points" />
              </PropertyMappings>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="draw:Path">
                <draw:Color>
                  <draw:Val0>0</draw:Val0>
                  <draw:Val1>140</draw:Val1>
                  <draw:Val2>255</draw:Val2>
                  <draw:Val3>0</draw:Val3>
                </draw:Color>
                <draw:Thickness>14</draw:Thickness>
                <draw:LineType>AntiAliased</draw:LineType>
                <draw:Shift>0</draw:Shift>
              </Combinator>
            </Expression>
            <Expression xsi:type="WorkflowOutput" />
          </Nodes>
          <Edges>
            <Edge From="0" To="9" Label="Source1" />
            <Edge From="1" To="2" Label="Source1" />
            <Edge From="1" To="3" Label="Source1" />
            <Edge From="1" To="4" Label="Source1" />
            <Edge From="2" To="6" Label="Source1" />
            <Edge From="3" To="6" Label="Source2" />
            <Edge From="4" To="6" Label="Source3" />
            <Edge From="5" To="6" Label="Source4" />
            <Edge From="6" To="7" Label="Source1" />
            <Edge From="7" To="8" Label="Source1" />
            <Edge From="8" To="9" Label="Source2" />
            <Edge From="9" To="12" Label="Source1" />
            <Edge From="6" To="10" Label="Source1" />
            <Edge From="10" To="11" Label="Source1" />
            <Edge From="11" To="12" Label="Source2" />
            <Edge From="12" To="13" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="GroupWorkflow">
        <Name>RightArm</Name>
        <Description>Wrist, elbow, shoulder.</Description>
        <Workflow>
          <Nodes>
            <Expression xsi:type="WorkflowInput">
              <Name>Source1</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>Pose</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="movenet:GetBodyPart">
                <movenet:Name>right_wrist</movenet:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="movenet:GetBodyPart">
                <movenet:Name>right_elbow</movenet:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="movenet:GetBodyPart">
                <movenet:Name>right_shoulder</movenet:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>Gap</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Zip" />
            </Expression>
            <Expression xsi:type="scr:ExpressionTransform">
              <scr:Name>Lines</scr:Name>
              <scr:Expression>new[] { Item1.Position, Item2.Position, Item3.Position }</scr:Expression>
            </Expression>
            <Expression xsi:type="PropertyMapping">
              <PropertyMappings>
                <Property Name="Points" />
              </PropertyMappings>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="draw:Path">
                <draw:Color>
                  <draw:Val0>255</draw:Val0>
                  <draw:Val1>200</draw:Val1>
                  <draw:Val2>0</draw:Val2>
                  <draw:Val3>0</draw:Val3>
                </draw:Color>
                <draw:Thickness>3</draw:Thickness>
                <draw:LineType>AntiAliased</draw:LineType>
                <draw:Shift>0</draw:Shift>
              </Combinator>
            </Expression>
            <Expression xsi:type="scr:ExpressionTransform">
              <scr:Name>Dots</scr:Name>
              <scr:Expression>new[] { Item1.Position, Item1.Position, Item4, Item2.Position, Item2.Position, Item4, Item3.Position, Item3.Position }</scr:Expression>
            </Expression>
            <Expression xsi:type="PropertyMapping">
              <PropertyMappings>
                <Property Name="Points" />
              </PropertyMappings>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="draw:Path">
                <draw:Color>
                  <draw:Val0>255</draw:Val0>
                  <draw:Val1>200</draw:Val1>
                  <draw:Val2>0</draw:Val2>
                  <draw:Val3>0</draw:Val3>
                </draw:Color>
                <draw:Thickness>14</draw:Thickness>
                <draw:LineType>AntiAliased</draw:LineType>
                <draw:Shift>0</draw:Shift>
              </Combinator>
            </Expression>
            <Expression xsi:type="WorkflowOutput" />
          </Nodes>
          <Edges>
            <Edge From="0" To="9" Label="Source1" />
            <Edge From="1" To="2" Label="Source1" />
            <Edge From="1" To="3" Label="Source1" />
            <Edge From="1" To="4" Label="Source1" />
            <Edge From="2" To="6" Label="Source1" />
            <Edge From="3" To="6" Label="Source2" />
            <Edge From="4" To="6" Label="Source3" />
            <Edge From="5" To="6" Label="Source4" />
            <Edge From="6" To="7" Label="Source1" />
            <Edge From="7" To="8" Label="Source1" />
            <Edge From="8" To="9" Label="Source2" />
            <Edge From="9" To="12" Label="Source1" />
            <Edge From="6" To="10" Label="Source1" />
            <Edge From="10" To="11" Label="Source1" />
            <Edge From="11" To="12" Label="Source2" />
            <Edge From="12" To="13" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="GroupWorkflow">
        <Name>LeftLeg</Name>
        <Description>Ankle, knee, hip.</Description>
        <Workflow>
          <Nodes>
            <Expression xsi:type="WorkflowInput">
              <Name>Source1</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
