      </Expression>
      <Expression xsi:type="GroupWorkflow">
        <Name>Trunk</Name>
        <Description>Shoulders and hips as a loop, then nose to both shoulders. No dots: the limbs already drew them.</Description>
        <Workflow>
          <Nodes>
            <Expression xsi:type="WorkflowInput">
              <Name>Source1</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>Pose</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="movenet:GetBodyPart">
                <movenet:Name>left_shoulder</movenet:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="movenet:GetBodyPart">
                <movenet:Name>right_shoulder</movenet:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="movenet:GetBodyPart">
                <movenet:Name>right_hip</movenet:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="movenet:GetBodyPart">
                <movenet:Name>left_hip</movenet:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="movenet:GetBodyPart">
                <movenet:Name>nose</movenet:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>Gap</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Zip" />
            </Expression>
            <Expression xsi:type="scr:ExpressionTransform">
              <scr:Name>Lines</scr:Name>
              <scr:Expression>new[] { Item4.Position, Item1.Position, Item2.Position, Item3.Position, Item4.Position, Item6, Item1.Position, Item5.Position, Item2.Position }</scr:Expression>
            </Expression>
            <Expression xsi:type="PropertyMapping">
              <PropertyMappings>
                <Property Name="Points" />
              </PropertyMappings>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="draw:Path">
                <draw:Color>
                  <draw:Val0>0</draw:Val0>
                  <draw:Val1>255</draw:Val1>
                  <draw:Val2>255</draw:Val2>
                  <draw:Val3>0</draw:Val3>
                </draw:Color>
                <draw:Thickness>3</draw:Thickness>
                <draw:LineType>AntiAliased</draw:LineType>
                <draw:Shift>0</draw:Shift>
              </Combinator>
            </Expression>
            <Expression xsi:type="WorkflowOutput" />
          </Nodes>
          <Edges>
            <Edge From="0" To="11" Label="Source1" />
            <Edge From="1" To="2" Label="Source1" />
            <Edge From="1" To="3" Label="Source1" />
            <Edge From="1" To="4" Label="Source1" />
            <Edge From="1" To="5" Label="Source1" />
            <Edge From="1" To="6" Label="Source1" />
            <Edge From="2" To="8" Label="Source1" />
            <Edge From="3" To="8" Label="Source2" />
            <Edge From="4" To="8" Label="Source3" />
            <Edge From="5" To="8" Label="Source4" />
            <Edge From="6" To="8" Label="Source5" />
            <Edge From="7" To="8" Label="Source6" />
            <Edge From="8" To="9" Label="Source1" />
            <Edge From="9" To="10" Label="Source1" />
            <Edge From="10" To="11" Label="Source2" />
            <Edge From="11" To="12" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="draw:DrawCanvas" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="movenet:GetBodyPart">
          <movenet:Name>nose</movenet:Name>
        </Combinator>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>Position</Selector>
      </Expression>
      <Expression xsi:type="scr:ExpressionTransform">
        <scr:Name>NaN point</scr:Name>
        <scr:Description>A point that is not a point. Path breaks the line wherever it meets one, so this is the gap between dots.</scr:Description>
        <scr:Expression>new Point2f(Single.NaN, Single.NaN)</scr:Expression>
      </Expression>
      <Expression xsi:type="rx:PublishSubject">
        <Name>Gap</Name>
      </Expression>
    </Nodes>
    <Edges>
      <Edge From="0" To="1" Label="Source1" />
      <Edge From="1" To="2" Label="Source1" />
      <Edge From="2" To="3" Label="Source1" />
      <Edge From="3" To="4" Label="Source1" />
      <Edge From="4" To="5" Label="Source1" />
